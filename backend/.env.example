# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=<YOUR_MONGODB_ATLAS_CONNECTION_STRING>
MONGODB_DB_NAME=trackseo

# Google Gemini API
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=<YOUR_SUPPORTED_GEMINI_MODEL>

# Browserbase — browser-based crawling (optional)
BROWSERBASE_API_KEY=<YOUR_BROWSERBASE_API_KEY>
BROWSERBASE_PROJECT_ID=<YOUR_BROWSERBASE_PROJECT_ID>
BROWSERBASE_SESSION_ID=

# Google Search Console (optional — future integration)
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Security
SESSION_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
